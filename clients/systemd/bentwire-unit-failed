#!/bin/sh
# Lets the bentwire character say that a systemd unit failed.
#
# usage: bentwire-unit-failed <unit>
#   plays GetAttention and says "The unit <unit> failed."
# Called by bentwire-failure@.service (OnFailure=bentwire-failure@%n.service). Always
# exits 0 once it has a unit name, so the failure handler itself never fails. Nothing is
# sent when bentwired is not running (no D-Bus activation).
#
# Environment: BENTWIRE_SYSTEMD_OFF=1 disables it; BENTWIRE_CLI names the CLI (default
# `bentwire`).

unit=${1:-}
[ -n "$unit" ] || { echo "usage: bentwire-unit-failed <unit>" >&2; exit 2; }
[ "${BENTWIRE_SYSTEMD_OFF:-}" = 1 ] && exit 0

running() {
    if command -v busctl >/dev/null 2>&1; then
        busctl --user --no-pager status org.bentwire.Agent >/dev/null 2>&1
    elif command -v dbus-send >/dev/null 2>&1; then
        dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
            org.freedesktop.DBus.NameHasOwner string:org.bentwire.Agent 2>/dev/null | grep -q true
    else
        return 0
    fi
}

cli() {
    if command -v timeout >/dev/null 2>&1; then
        timeout 3 "${BENTWIRE_CLI:-bentwire}" "$@"
    else
        "${BENTWIRE_CLI:-bentwire}" "$@"
    fi
}

running || exit 0
cli play GetAttention >/dev/null
cli say "The unit $unit failed." >/dev/null
exit 0
